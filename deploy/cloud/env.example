# Public port assigned by the cloud platform. Most platforms inject PORT.
PORT=5000

# Node backend internal port.
BACKEND_PORT=3000

# Feishu push target.
# Option A: custom group robot webhook.
FEISHU_ARTICLE_WEBHOOK_URL=

# Option B: Feishu app sends directly to a group. This is better for product use.
LARK_APP_ID=
LARK_APP_SECRET=
FEISHU_ARTICLE_CHAT_ID=

# WeChat article polling.
WECHAT_ARTICLE_POLL_ENABLED=true
WECHAT_ARTICLE_POLL_ON_START=true
WECHAT_ARTICLE_POLL_INTERVAL_MS=300000
WECHAT_ARTICLE_DYNAMIC_SUBSCRIPTIONS=true
WECHAT_PUSH_EXISTING_ON_FIRST_RUN=false
WECHAT_ARTICLE_PUSH_FIELDS=account,title,digest,link
WECHAT_ARTICLE_PUSH_TITLE_PREFIX=WeChat article update

# Login reminder.
WECHAT_LOGIN_REMINDER_ENABLED=true
WECHAT_LOGIN_REMINDER_THRESHOLD_HOURS=12

# Persistent paths inside the container. Mount a cloud disk at /data.
WECHAT_DATA_DIR=/data/wechat-api
WECHAT_ARTICLE_STATE_PATH=/data/backend/wechat-article-push-state.json
RSS_DB_PATH=/data/wechat-api/rss.db
