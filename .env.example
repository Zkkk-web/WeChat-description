PORT=3000
NODE_ENV=development

# Reserved for later milestones.
LARK_APP_ID=
LARK_APP_SECRET=
MODEL_API_KEY=
WEBHOOK_SECRET=

# Feishu Base writeback. Keep disabled until mailbox classification is verified.
LARK_BASE_WRITE_ENABLED=false
LARK_WRITE_MODE=app
LARK_CLI_COMMAND=lark-cli.cmd
LARK_CLI_AS=user
LARK_CLI_TIMEOUT_MS=20000
LARK_API_BASE=https://open.feishu.cn/open-apis
LARK_BASE_TOKEN=ZyYAb61ewaI0MFsTzM9cmb4xnKd
LARK_TABLE_MAIL_EVENTS=tblnMJc1DIJQHpps
LARK_TABLE_CANDIDATES=tbl2zbTyiwbr5qAk
LARK_TABLE_CLIENTS=tblVH4kqYOXwXtvx
LARK_TABLE_JOBS=tblWnU6FVN7kZNHY
LARK_TABLE_HUNTERS=tblZW1hmvdSDzu5Q
LARK_TABLE_ECOSYSTEM_PARTNERS=tbl4VAA3l8hLxtKp

# Feishu content fetching for event-driven workflows.
# Use a user_access_token when subscribing user mailbox/minutes events.
LARK_CONTENT_FETCH_ENABLED=false
LARK_USER_ACCESS_TOKEN=
LARK_TENANT_ACCESS_TOKEN=

# 163 IMAP polling hook. IMAP_PASSWORD must be the client authorization code,
# not the web login password.
MAIL_POLL_ENABLED=false
MAIL_POLL_INTERVAL_MS=180000
MAIL_POLL_ON_START=false
MAIL_POLL_TIMEOUT_MS=120000
MAIL_POLL_MAX_MESSAGES=30
MAIL_POLL_INCLUDE_SEEN=false
MAIL_POLL_SKIP_UNCHANGED=true
MAIL_PROCESSED_STORE_PATH=.codex-tmp/processed-mail-ids.json
MAIL_MARK_SEEN_TIMEOUT_MS=5000
MAIL_STOP_AFTER_PROCESSED=false
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_CONNECTION_TIMEOUT_MS=30000
IMAP_USER=19932079997@163.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# WeChat official account article polling -> Feishu group webhook.
# WECHAT_DOWNLOAD_API_BASE points to tmwgsicp/wechat-download-api.
WECHAT_ARTICLE_POLL_ENABLED=false
WECHAT_DOWNLOAD_API_BASE=http://127.0.0.1:5000
WECHAT_ARTICLE_FAKEID=
WECHAT_ARTICLE_FAKEIDS=
# Optional display names for broken upstream nicknames:
# fakeid:name,fakeid2:name2
WECHAT_ARTICLE_ACCOUNT_NAMES=
WECHAT_ARTICLE_POLL_INTERVAL_MS=300000
WECHAT_ARTICLE_POLL_ON_START=false
WECHAT_ARTICLE_STOP_AFTER_POLL=false
WECHAT_ARTICLE_POLL_LIMIT=20
WECHAT_ARTICLE_STATE_PATH=.codex-tmp/wechat-article-push-state.json
WECHAT_PUSH_EXISTING_ON_FIRST_RUN=false
FEISHU_ARTICLE_WEBHOOK_URL=
FEISHU_ARTICLE_CHAT_ID=
WECHAT_ARTICLE_PUSH_FIELDS=account,title,digest,link
WECHAT_LOGIN_REMINDER_ENABLED=true
WECHAT_LOGIN_REMINDER_THRESHOLD_HOURS=12
WECHAT_ARTICLE_DYNAMIC_SUBSCRIPTIONS=true
WECHAT_ARTICLE_PUSH_TITLE_PREFIX=微信公众号更新
